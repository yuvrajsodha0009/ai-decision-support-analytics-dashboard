PORT=5000
MONGO_URI=mongodb://localhost:27017/analytics-dashboard
JWT_SECRET=replace-with-a-secure-secret
AI_SERVICE_URL=http://localhost:8000/analyze
ASK_AGENT_URL=http://127.0.0.1:8010/analyze
MONGO_SERVER_SELECTION_TIMEOUT_MS=2500
MONGO_CONNECT_TIMEOUT_MS=2500

# OTP email delivery
# Use one: SMTP or Resend or Brevo. Provider order can be configured with OTP_EMAIL_PROVIDER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# OTP provider control: auto|smtp|resend|brevo
OTP_EMAIL_PROVIDER=auto
OTP_EMAIL_MAX_RETRIES=2
SMTP_SKIP_VERIFY=false

# Resend fallback (optional)
RESEND_API_KEY=
RESEND_FROM=

# Brevo fallback (optional)
BREVO_API_KEY=
BREVO_FROM=

# OTP behavior
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_OTP_RESEND_COOLDOWN_SECONDS=60
